{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-browser"
  ],
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    },
    "playwright-headless": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--headless",
        "--no-sandbox"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow"
  }
}
