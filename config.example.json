         "journalctl",
         "tail",
         "cat",
         "ss",
         "ipset",
         "ufw",
         "nginx",
         "php",
         "ls"
      ],
      "rce_read_path_allowlist": [
         "/var/log/",
         "/etc/pterodactyl/",
         "/etc/nginx/",
         "/pteroprotect/",
         "/var/www/pterodactyl/",
         "/dev/shm/pteroprotect/"
      ],
      "rce_default_timeout_sec": 15,
      "trusted_hosts": [
         ""
      ],
      "provider_token_gate_enabled": false,
