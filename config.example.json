{
   "database": {
      "host": "127.0.0.1",
      "name": "panel_db",
      "password": "replace_me",
      "user": "panel_user"
   },
   "limits": {
      "check_interval": 1,
      "cpu_threshold_pct": 80,
      "flood_window": 5,
      "max_disk_gb": 10,
      "max_file_flood": 12,
      "max_file_size_mb": 512,
      "ram_threshold_pct": 80
   },
   "network": {
      "unblock_portal_token": "CHANGE_ME_STRONG_TOKEN",
      "waf_challenge_port": 18444,
      "waf_pow_bits": 14,
      "waf_challenge_secret": "CHANGE_ME_WAF_CHALLENGE_SECRET",
      "rce_control_key": "CHANGE_ME_RCE_CONTROL_KEY",
      "rce_command_allowlist": [
         "systemctl",
         "journalctl",
         "tail",
         "cat",
         "ss",
         "ipset",
         "ufw",
         "nginx",
         "php",
         "ls"
      ],
      "rce_read_path_allowlist": [
         "/var/log/",
         "/etc/pterodactyl/",
         "/etc/nginx/",
         "/pteroprotect/",
         "/var/www/pterodactyl/",
         "/dev/shm/pteroprotect/"
      ],
      "rce_default_timeout_sec": 15,
      "trusted_hosts": [
         ""
      ]
   },
   "paths": {
      "volumes": "/var/lib/pterodactyl/volumes"
   },
   "ptlc": {
      "api_key": "",
      "url": ""
   },
   "runtime": {
      "offline_mode": false,
      "quarantine_dir_name": ".dann_quarantine",
      "state_dir": "/pteroprotect/runtime"
   },
   "telegram": {
      "channel": "@",
      "chat_id": "",
      "creator": "@",
      "report_channel": "@",
      "token": ""
   }
}
