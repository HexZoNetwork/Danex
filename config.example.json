   "network": {
      "unblock_portal_token": "ekjo",
      "waf_challenge_port": 18444,
      "waf_challenge_enabled": true,
      "waf_challenge_strict_mode": true,
      "waf_challenge_ttl_sec": 1800,
      "waf_pow_bits": 14,
      "waf_challenge_type": 1,
      "waf_challenge_theme_custom_enabled": false,
      "waf_challenge_theme_gradient_start": "#0d1b2a",
