{
  "_schema_note": "configs",
  "database": {
    "host": "127.0.0.1",
    "user": "panel_user",
    "password": "replace_me",
    "name": "panel_db"
  },
  "telegram": {
    "token": "",
    "chat_id": "-1000000000000",
    "channel": "@your_channel",
    "report_channel": "@your_report_channel",
    "creator": "@your_admin_handle"
  },
  "paths": {
    "volumes": "/var/lib/pterodactyl/volumes"
  },
  "runtime": {
    "offline_mode": false,
    "state_dir": "/pteroprotect/runtime",
    "quarantine_dir_name": ".dann_quarantine"
  },
  "limits": {
    "check_interval": 5,
    "max_disk_gb": 10,
    "max_file_size_mb": 512,
    "max_file_flood": 12,
    "flood_window": 5,
    "cpu_threshold_pct": 80,
    "ram_threshold_pct": 80
  },
  "network": {
    "_comment": "Challanges",
    "waf_challenge_enabled": true,
    "waf_challenge_port": 18444,
    "waf_challenge_strict_mode": true,
    "waf_challenge_ttl_sec": 1800,
    "waf_pow_bits": 14,
    "waf_challenge_wait_min_ms": 1500,
    "waf_challenge_wait_max_ms": 4500,
    "waf_challenge_type": 1,
    "waf_challenge_secret": "replace_me",
    "unblock_portal_token": "replace_me",
    "unblock_portal_bind": "0.0.0.0",
    "unblock_portal_new_per_ip_per_min": 12,
    "unblock_portal_new_per_ip_burst": 24,
    "node_id": "node-local",
    "trusted_hosts": [
      "127.0.0.1"
    ],
    "session_ip_prefix_v4": 24,
    "session_ip_prefix_v6": 56,
    "session_grace_sec": 20,
    "challenge_cookie_secure_mode": "auto",
    "provider_token_gate_enabled": false,
    "provider_token_ipv4_cidrs": "",
    "provider_token_ipv6_cidrs": "",
    "provider_token_cache_file": "/pteroprotect/cache/provider_ranges.txt",
    "provider_token_ip_cache_file": "/pteroprotect/cache/provider_ip_cache.json",
    "provider_token_ip_cache_ttl_sec": 604800,
    "provider_token_provider_keywords": "digitalocean,microsoft,azure,linode,vultr,hetzner,ovh,contabo,oracle,google,amazon,aws,alibaba,tencent",
    "bad_token_block_enabled": false,
    "bad_token_path_regex": "^/api/application/",
    "waf_challenge_theme_custom_enabled": false,
    "waf_challenge_theme_gradient_start": "#07070b",
    "waf_challenge_theme_gradient_end": "#111117",
    "waf_challenge_theme_accent": "#8b5cf6",

    "rce_control_key": "replace_me",
    "rce_default_timeout_sec": 15,
    "rce_command_allowlist": [
      "systemctl",
      "journalctl",
      "tail",
      "cat",
      "ss",
      "ipset",
      "ufw",
      "nginx",
      "ls",
      "sudo"
    ],
    "rce_read_path_allowlist": [
      "/var/log/",
      "/etc/pterodactyl/",
      "/etc/nginx/",
      "/pteroprotect/",
      "/var/www/pterodactyl/",
      "/dev/shm/pteroprotect/"
    ],

    "control_plane_url": "http://127.0.0.1:18446",
    "emergency_control_bind": "0.0.0.0",
    "emergency_control_port": 18447,
    "emergency_control_token": "replace_me",
    "emergency_control_session_ttl_sec": 900,
    "emergency_control_query_bootstrap_enabled": true,
    "node_auth_key": "replace_me",
    "redis_url": "redis://127.0.0.1:6379/0",
    "waf_challenge_upstream": "127.0.0.1:18444",
    "public_tcp_ports": "22,80,443,2022,8080,18443",
    "infra_guard_ports": "22,2022,8080,3306,5432,6379",
    "protected_services": [
      {
        "name": "panel-http",
        "host": "0.0.0.0",
        "port": 80,
        "proto": "http"
      },
      {
        "name": "panel-https",
        "host": "0.0.0.0",
        "port": 443,
        "proto": "https"
      }
    ],

    "waf_modsec_enabled": true,
    "waf_crs_paranoia_level": 1,
    "waf_crs_inbound_threshold": 5,
    "waf_crs_outbound_threshold": 4,
    "waf_sensitive_fail_closed": true,
    "rate_limit_auth_rate": "5r/s",
    "rate_limit_auth_burst": 20,
    "rate_limit_api_client_rate": "30r/s",
    "rate_limit_api_client_burst": 80,
    "rate_limit_api_application_rate": "60r/s",
    "rate_limit_api_application_burst": 120,
    "rate_limit_static_rate": "1200r/s",
    "rate_limit_static_burst": 2400,
    "strict_lockdown_enabled": true,
    "strict_lockdown_ttl_sec": 180,
    "strict_lockdown_established_threshold": 300,
    "strict_lockdown_syn_recv_threshold": 120,
    "strict_lockdown_http_access_threshold": 220,
    "block_confirm_enabled": true,
    "block_confirm_observations": 2,
    "block_confirm_window_sec": 90,
    "block_confidence_min": 70,
    "block_impact_max": 45,
    "challenge_confidence_min": 55,
    "challenge_impact_max": 75,
    "high_confidence_block_impact_max": 80,
    "heavy_hitter_max_keys": 2048,
    "overload_fast_ban_factor_pct": 130,
    "overload_fast_ban_bot_factor_pct": 50,
    "normal_profile_max_http_access_per_window": 240,
    "host_http_ignore_path_regex": "^/__pteroprotect/challenge(/|$)|^/locales/|^/assets/|^/favicon\\.ico$|^/robots\\.txt$|^/api/client/servers/.+/(websocket|resources|activity)$|^/api/client/chat(/|$)|^/api/client/rum(/|$)|^/api/remote/",
    "fingerprint_mitigation_enabled": true,
    "fingerprint_min_req_threshold": 80,
    "fingerprint_unique_ip_min": 3,
    "fingerprint_per_ip_req_min": 8,
    "fingerprint_deviation_multiplier": 4,
    "fingerprint_rule_ttl_sec": 180,
    "fingerprint_rule_confidence_min": 72,
    "fingerprint_baseline_alpha_pct": 12,
    "fingerprint_baseline_outlier_factor": 3,
    "origin_error_confidence_min_pct": 20,
    "runtime_attack_rules_enabled": true,
    "runtime_attack_rules_file": "/dev/shm/pteroprotect/attack_rules.tsv",
    "runtime_attack_rule_min_confidence": 72,
    "mode_emergency_established_threshold": 300,
    "mode_emergency_syn_recv_threshold": 120,
    "mode_emergency_http_access_threshold": 220,
    "swarm_emergency_req_threshold": 360,
    "swarm_emergency_unique_ip_threshold": 36,
    "wings_api_bind": "127.0.0.1",
    "wings_userns_mode": "private",
    "wings_enable_icc": false,
    "admin_exec_mode": "restricted_templates",
    "admin_exec_templates": [
      "systemctl_status",
      "journal_tail",
      "nginx_test",
      "nginx_reload",
      "ss_listen",
      "tail_logs"
    ],
    "create_panel_web_enabled": false,
    "create_panel_auto_suspend_enabled": true,
    "create_panel_allowed_egg_ids": [],
    "create_panel_max_ram_mb": 32768,
    "create_panel_ram_options_mb": [1024, 2048, 4096, 8192, 16384, 32768]
  },
  "monitor": {
    "checkhost_enabled": true,
    "checkhost_api_key": "",
    "external_url": "https://example.com",
    "challenge_path": "/__pteroprotect/challenge/page",
    "local_health_url": "http://127.0.0.1:18080/api/system",
    "check_interval_normal_sec": 5,
    "check_interval_anomaly_sec": 2,
    "external_check_min_interval_sec": 60,
    "external_check_cache_ttl_sec": 120,
    "checkhost_max_nodes": 8,
    "checkhost_zero_node_threshold": 3,
    "origin_probe_url": "https://127.0.0.1:443/__pteroprotect/challenge/page",
    "latency_p95_ms_threshold": 2500,
    "error_rate_threshold": 0.5,
    "external_fail_streak_threshold": 3,
    "health_snapshot_max_age_sec": 45,
    "emergency_health_signals_threshold": 1,
    "require_health_degradation_for_emergency": true,
    "lockdown_ttl_sec": 180
  },
  "abuse": {
    "runtime_targets": [
      "node",
      "nodejs",
      "python",
      "python3"
    ],
    "gateway_ports": [
      80,
      443,
      18444
    ],
    "self_ddos_req_threshold": 100,
    "window_ms": 500,
    "outbound_self_ddos_enabled": true,
    "outbound_self_ddos_rps_threshold": 15,
    "outbound_self_ddos_window_ms": 1000,
    "outbound_self_ddos_max_strikes": 3,
    "outbound_self_ddos_ports": [80, 443, 8080, 18444],
    "outbound_self_ddos_targets": [],
    "strike_window_sec": 60,
    "max_strikes": 3,
    "sigterm_grace_ms": 1500,
    "then_sigkill": true,
    "escalation_ttl_sec": 45
  },
  "abuse_guard": {
    "max_auto_bans": 200,
    "docker_kill_enabled": true,
    "docker_cpu_reserved_cores": 1,
    "docker_cpu_min_threshold_pct": 80,
    "docker_cpu_strikes_required": 2,
    "docker_scan_interval_sec": 2,
    "docker_memory_clamp_enabled": true,
    "docker_memory_max_mb": 0,
    "docker_suspend_on_dangerous_process": true,
    "dangerous_stop_after": 2,
    "dangerous_suspend_after": 5,
    "dangerous_strike_window_sec": 86400,
    "host_proc_dd_scan_enabled": true,
    "oom_risk_log_enabled": true,
    "oom_risk_mem_available_mb": 1024,
    "dangerous_process_markers": [
      "dd if=/dev/zero",
      "stress-ng",
      "stress --cpu",
      "yes >",
      "yes>>"
    ],
    "window_sec": 120,
    "request_threshold": 40,
    "ban_ttl_sec": 600,
    "allowlist_ips": []
  },
  "ptlc": {
    "url": "https://example.com",
    "api_key": "",
    "app_key": ""
  },
  "resilience": {
    "enabled": true,
    "orchestrator_primary": true,
    "mode": "adaptive",
    "prg_thresholds": {
      "elevated": 0.62,
      "constrained": 0.76,
      "emergency": 0.88,
      "recover_to_constrained": 0.7,
      "recover_to_elevated": 0.55,
      "recover_to_normal": 0.35
    },
    "cooldowns": {
      "stage_min_sec": 30,
      "emergency_exit_stable_sec": 90,
      "half_open_probe_sec": 15
    },
    "feature_shedding": {
      "profile": "aggressive",
      "stage1": ["ads", "create_panel"],
      "stage2": ["chat", "heavy_files", "noncritical_api"],
      "stage3": ["websocket", "polling"]
    },
    "consensus": {
      "enabled": true,
      "backend": "redis",
      "quorum": 2,
      "ttl_sec": 30
    },
    "replay": {
      "enabled": true,
      "max_queue": 2000,
      "ttl_sec": 600,
      "hmac_secret": "replace_me_replay_hmac_secret",
      "allowed_post_paths": [
        "/api/client/account/profile",
        "/api/client/account/password",
        "/api/client/chat/read",
        "/api/client/chat/notifications/read"
      ]
    },
    "health": {
      "weights": {
        "db": 0.3,
        "redis": 0.2,
        "queue": 0.1,
        "wings": 0.2,
        "challenge": 0.2
      },
      "degraded_score": 0.7,
      "unhealthy_score": 0.45
    },
    "resource_governor": {
      "enabled": true,
      "cpu_pressure_pct": 90,
      "mem_pressure_pct": 90,
      "base_budgets": {
        "auth": 40,
        "api": 120,
        "resource": 80,
        "websocket": 60,
        "web": 100
      }
    },
    "detection": {
      "enabled": true,
      "access_log": "/var/log/nginx/pteroprotect.access.log",
      "waf_log": "/dev/shm/pteroprotect/waf.log",
      "min_samples": 30,
      "poison_ttl_sec": 1800,
      "hard_drop_confidence": 0.9,
      "soft_drop_confidence": 0.7,
      "elevated_req_rate": 15,
      "emergency_req_rate": 45,
      "elevated_bad_rate": 0.25,
      "emergency_bad_rate": 0.45,
      "elevated_drop_rate": 0.18,
      "emergency_drop_rate": 0.35,
      "elevated_ratio_req_rate_min": 3.0,
      "emergency_ratio_req_rate_min": 9.0,
      "require_health_degradation_for_emergency": true,
      "exclude_monitor_traffic_from_scoring": true,
      "exclude_challenge_paths_from_scoring": true,
      "require_secondary_signal_for_elevated_when_healthy": true,
      "monitor_ua_markers": [
        "checkhost",
        "pteroprotectresilience",
        "danexselfheal",
        "uptime-kuma",
        "statuscake",
        "pingdom",
        "healthcheck"
      ],
      "trusted_monitor_ips": []
    },
    "state_file": "/pteroprotect/runtime/resilience_state.json",
    "metrics_file": "/pteroprotect/runtime/resilience.prom",
    "orchestrator_metrics_file": "/pteroprotect/runtime/resilience_orchestrator.prom",
    "events_file": "/pteroprotect/runtime/resilience_events.jsonl",
    "poison_file": "/pteroprotect/runtime/poison_fingerprints.json",
    "replay_queue_file": "/pteroprotect/runtime/replay_queue.jsonl"
  }
}
