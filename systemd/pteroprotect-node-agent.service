[Unit]
StartLimitBurst=5
StartLimitIntervalSec=300
Description=PteroProtect Node Agent
After=network-online.target pteroprotect-control-plane.service
Wants=network-online.target

[Service]
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/pteroprotect /var/lib/pterodactyl /var/www/pterodactyl /dev/shm/pteroprotect /var/log /run /tmp /dev/shm
Type=simple
User=root
Group=root
Environment=PTEROPROTECT_CONFIG_PATH=/pteroprotect/config.json
ExecStart=/usr/bin/python3 /pteroprotect/scripts/pteroprotect_node_agent.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
