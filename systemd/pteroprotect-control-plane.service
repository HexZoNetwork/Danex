[Unit]
Description=PteroProtect Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PTEROPROTECT_CONFIG_PATH=/pteroprotect/config.json
ExecStart=/usr/bin/python3 /pteroprotect/scripts/pteroprotect_control_plane.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
