[Unit]
Description=PteroProtect Self-Heal Monitor
After=network-online.target pteroprotect.service nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/pteroprotect
Environment=DANN_CONFIG_PATH=/pteroprotect/config.json
Environment=PTEROPROTECT_RUNTIME_DIR=/dev/shm/pteroprotect
Environment=PTEROPROTECT_PANEL_RUNTIME_DIR=/pteroprotect/runtime
ExecStartPre=/usr/bin/env bash /pteroprotect/scripts/validator_preflight.sh
ExecStart=/usr/bin/env python3 /pteroprotect/scripts/self_heal_monitor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
