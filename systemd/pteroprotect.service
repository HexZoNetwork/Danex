[Unit]
Description=PteroProtect Offline Guard
After=network-online.target docker.service mariadb.service mysql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/pteroprotect
Environment=DANN_GUARD_HOME=/pteroprotect
ExecStart=/pteroprotect/dann_guard
Restart=always
RestartSec=15
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
