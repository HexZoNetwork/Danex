[Unit]
StartLimitBurst=5
StartLimitIntervalSec=300
Description=PteroProtect break-glass terminal helper
After=network.target

[Service]
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Type=simple
User=root
Group=root
Environment=PTEROPROTECT_TERMINAL_HOST=127.0.0.1
Environment=PTEROPROTECT_TERMINAL_PORT=18445
Environment=PTEROPROTECT_TERMINAL_TICKET_DIR=/dev/shm/pteroprotect/terminal_tickets
Environment=PTEROPROTECT_TERMINAL_TICKET_GROUP=www-data
Environment=PTEROPROTECT_TERMINAL_REPLAY_DIR=/dev/shm/pteroprotect/terminal_replay
Environment=PTEROPROTECT_TERMINAL_BIND_IP=1
Environment=PTEROPROTECT_TERMINAL_BIND_UA=1
Environment=PTEROPROTECT_TERMINAL_AUDIT_DIR=/var/log/pteroprotect/terminal
ExecStart=/pteroprotect/scripts/pteroprotect_terminal_helper.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=false
ProtectHome=false

[Install]
WantedBy=multi-user.target
