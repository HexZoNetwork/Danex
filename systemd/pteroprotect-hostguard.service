[Unit]
Description=PteroProtect Host Firewall Guard
After=network-online.target docker.service
Wants=network-online.target

[Service]
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true

ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/pteroprotect /var/lib/pterodactyl /var/www/pterodactyl /dev/shm/pteroprotect /var/log /run /tmp /dev/shm

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ReadWritePaths=/pteroprotect /var/lib/pterodactyl /run /proc/sys/net /var/log /dev/shm /tmp
Type=oneshot
User=root
Group=root
Environment=DANN_GUARD_HOME=/pteroprotect
ExecStart=/pteroprotect/scripts/install_host_protection.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
