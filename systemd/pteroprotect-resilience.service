[Unit]
StartLimitBurst=5
StartLimitIntervalSec=300
Description=PteroProtect Resilience Orchestrator
After=network-online.target pteroprotect-control-plane.service pteroprotect-selfheal.service
Wants=network-online.target

[Service]
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true

ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/pteroprotect /var/lib/pterodactyl /var/www/pterodactyl /dev/shm/pteroprotect /var/log /run /tmp /dev/shm

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ReadWritePaths=/pteroprotect /var/lib/pterodactyl /run /proc/sys/net /var/log /dev/shm /tmp
Type=simple
User=root
Group=root
SupplementaryGroups=adm
WorkingDirectory=/pteroprotect
Environment=DANN_CONFIG_PATH=/pteroprotect/config.json
Environment=PTEROPROTECT_PANEL_RUNTIME_DIR=/pteroprotect/runtime
ExecStart=/usr/bin/env python3 /pteroprotect/scripts/resilience_orchestrator.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
