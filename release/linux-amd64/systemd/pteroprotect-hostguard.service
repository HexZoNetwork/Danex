[Unit]
Description=PteroProtect Host Firewall Guard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=DANN_GUARD_HOME=/pteroprotect
ExecStart=/pteroprotect/scripts/install_host_protection.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
